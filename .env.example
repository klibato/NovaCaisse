# ─── Base de données ───
DATABASE_URL=postgresql://novacaisse:novacaisse@db:5432/novacaisse
POSTGRES_USER=novacaisse
POSTGRES_PASSWORD=novacaisse
POSTGRES_DB=novacaisse

# ─── Redis ───
REDIS_URL=redis://redis:6379

# ─── API ───
JWT_SECRET=change-me-in-production
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
PORT=4000

# ─── Frontend ───
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── Production (docker-compose.prod.yml) ───
# DB_USER=novacaisse
# DB_PASSWORD=<mot-de-passe-fort-32-chars-minimum>
# JWT_SECRET=<secret-64-chars-minimum-genere-avec-openssl-rand-hex-64>
# REDIS_PASSWORD=<mot-de-passe-redis-fort>
# ACME_EMAIL=admin@novacaisse.fr
# NEXT_PUBLIC_API_URL=https://api.novacaisse.fr
# CORS_ORIGIN=https://*.novacaisse.fr

